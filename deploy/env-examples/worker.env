NODE_ENV=production
CUSTOMER_TEMPLATE_KEY=replace-me-template
DATABASE_URL=postgresql://platform_app:replace-me@postgres:5432/platform
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-me
CACHE_INVALIDATION_WEBHOOK_SECRET=replace-me-with-at-least-32-characters
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=replace-me-customer-bucket
S3_ACCESS_KEY_ID=replace-me-storage-user
S3_SECRET_ACCESS_KEY=replace-me-storage-secret
OPENROUTER_API_KEY=replace-me
X_API_KEY=replace-me
X_API_SECRET=replace-me
# Add the destination binding names required by the selected customer template.
# DEST_<ACCOUNT_KEY>_TELEGRAM_BOT_TOKEN=replace-me
# DEST_<ACCOUNT_KEY>_X_ACCESS_TOKEN=replace-me
# DEST_<ACCOUNT_KEY>_X_ACCESS_TOKEN_SECRET=replace-me
# Market provider bindings are required only when Market Analysis is enabled.
MARKET_BINANCE_ENABLED=true
MARKET_BINANCE_GEO_ALLOWED=true
MARKET_BINANCE_ATTRIBUTION_IDENTITY=replace-me-operator-identity
MARKET_COINMARKETCAP_PUBLIC_ENABLED=true
MARKET_COINMARKETCAP_PUBLIC_ATTRIBUTION_IDENTITY=replace-me-operator-identity
# Optional for a future customer template that declares CoinGecko mappings.
# MARKET_COINGECKO_ENABLED=true
# MARKET_COINGECKO_ATTRIBUTION_IDENTITY=replace-me-operator-identity
# COINGECKO_API_KEY=replace-me
SENTRY_DSN=
WORKER_MODE=durable
FIRECRAWL_API_KEY=replace-me-firecrawl-key
