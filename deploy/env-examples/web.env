NODE_ENV=production
CUSTOMER_TEMPLATE_KEY=replace-me-template
DATABASE_URL=postgresql://platform_app:replace-me@postgres:5432/platform
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters
BETTER_AUTH_URL=https://customer.example.com
CORS_ORIGIN=https://customer.example.com
APP_URL=https://customer.example.com
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-me-with-a-stable-base64-key
CACHE_INVALIDATION_WEBHOOK_SECRET=replace-me-with-at-least-32-characters
INNGEST_SIGNING_KEY=replace-me
# Required when any task routes remote (shipped fallbacks are remote)
OPENROUTER_API_KEY=replace-me
# Host Ollama verified curl -fsS http://127.0.0.1:11434/api/tags; Compose: http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=replace-me-customer-bucket
S3_ACCESS_KEY_ID=replace-me-storage-user
S3_SECRET_ACCESS_KEY=replace-me-storage-secret
ASSISTANT_APPROVAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
