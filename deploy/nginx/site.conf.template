limit_req_zone $binary_remote_addr zone=chainreporter_app:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=chainreporter_auth:10m rate=2r/s;

server {
    listen 80;
    listen [::]:80;
    server_name @PUBLIC_HOST@;
    return 301 https://@PUBLIC_HOST@$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @PUBLIC_HOST@;

    ssl_certificate @TLS_CERTIFICATE@;
    ssl_certificate_key @TLS_CERTIFICATE_KEY@;

    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    client_max_body_size 32m;
    client_body_timeout 30s;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_connect_timeout 5s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    location ^~ /api/internal/ {
        return 404;
    }

    location ^~ /api/publishing-media/ {
        access_log off;
        limit_req zone=chainreporter_app burst=20 nodelay;
        proxy_pass http://127.0.0.1:@WEB_LOOPBACK_PORT@;
    }

    location = /api/auth/sign-in/email {
        limit_req zone=chainreporter_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:@WEB_LOOPBACK_PORT@;
    }

    location /api/chat {
        limit_req zone=chainreporter_app burst=20 nodelay;
        proxy_read_timeout 300s;
        proxy_pass http://127.0.0.1:@WEB_LOOPBACK_PORT@;
    }

    location / {
        limit_req zone=chainreporter_app burst=40 nodelay;
        proxy_pass http://127.0.0.1:@WEB_LOOPBACK_PORT@;
    }
}
