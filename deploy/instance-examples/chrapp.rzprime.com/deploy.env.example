COMPOSE_PROJECT_NAME=chainreporter-platform
APP_VERSION=replace-me-immutable-tag
CUSTOMER_TEMPLATE_KEY=chainreporter
IMAGE_PREFIX=chainreporter-platform
ENV_DIR=/var/www/chainreporter-platform/env
BUILD_SECRET_FILE=/var/www/chainreporter-platform/env/build.env
APP_ROOT=/var/www/chainreporter-platform
APP_USER=chainreporter
PUBLIC_HOST=chrapp.rzprime.com
PUBLIC_IP=5.75.207.209
WEB_LOOPBACK_PORT=3100
WORKER_LOOPBACK_PORT=3101
MINIO_API_LOOPBACK_PORT=9000
MINIO_CONSOLE_LOOPBACK_PORT=9001
TLS_CERTIFICATE=/etc/letsencrypt/live/chrapp.rzprime.com/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/chrapp.rzprime.com/privkey.pem
NGINX_SITE_AVAILABLE=/etc/nginx/sites-available/chrapp.rzprime.com
NGINX_SITE_ENABLED=/etc/nginx/sites-enabled/chrapp.rzprime.com
MIN_FREE_MEMORY_MB=2048
OPERATOR_EMAIL=replace-me@example.com
OPERATOR_NAME=Operator
