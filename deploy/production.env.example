COMPOSE_PROJECT_NAME=replace-me-platform
APP_VERSION=replace-me-immutable-tag
CUSTOMER_TEMPLATE_KEY=replace-me-template
IMAGE_PREFIX=replace-me-platform
ENV_DIR=./env-examples
BUILD_SECRET_FILE=./env-examples/build.env
APP_ROOT=/var/www/replace-me-platform
APP_USER=replace-me-platform
PUBLIC_HOST=customer.example.com
PUBLIC_IP=192.0.2.10
WEB_LOOPBACK_PORT=3100
WORKER_LOOPBACK_PORT=3101
MINIO_API_LOOPBACK_PORT=9000
MINIO_CONSOLE_LOOPBACK_PORT=9001
TLS_CERTIFICATE=/etc/letsencrypt/live/customer.example.com/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/customer.example.com/privkey.pem
NGINX_SITE_AVAILABLE=/etc/nginx/sites-available/customer.example.com
NGINX_SITE_ENABLED=/etc/nginx/sites-enabled/customer.example.com
MIN_FREE_MEMORY_MB=2048
OPERATOR_EMAIL=replace-me@example.com
OPERATOR_NAME=Operator
