{
  "name": "@rz-chain-reporter/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "browser": "./src/browser.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "browser": "./src/browser.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check": "biome check .",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/dev.ts",
    "probe:source-import": "tsx src/probes/source-import.ts",
    "probe:analysis-run-candidates": "tsx src/probes/analysis-run-candidates.ts",
    "probe:assistant-run-start": "tsx src/probes/assistant-run-start.ts",
    "probe:publishing-domain": "tsx src/probes/publishing-domain.ts",
    "probe:presentation-localization": "tsx src/probes/editorial-presentation-localization.ts",
    "probe:presentation-translation": "tsx src/probes/editorial-presentation-localization-request.ts",
    "probe:copy-variant-localization": "tsx src/probes/copy-variant-localization.ts",
    "probe:market-catalog-bootstrap": "tsx src/probes/market-catalog-bootstrap.ts",
    "probe:market-analysis": "tsx src/probes/market-analysis.ts",
    "template:reconcile": "tsx src/reconcile/cli.ts",
    "probe:platform-draft": "tsx src/probes/platform-draft.ts revision",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@rz-chain-reporter/cache-invalidation": "workspace:*",
    "@rz-chain-reporter/contracts": "workspace:*",
    "@rz-chain-reporter/customer-template": "workspace:*",
    "@rz-chain-reporter/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@rz-chain-reporter/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "dotenv": "catalog:",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "catalog:"
  }
}
