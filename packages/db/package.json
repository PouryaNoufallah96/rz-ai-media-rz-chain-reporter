{
  "name": "@rz-chain-reporter/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./browser": {
      "default": "./src/browser.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "browser": {
    ".": "./src/browser.ts",
    "./src/index.ts": "./src/browser.ts"
  },
  "scripts": {
    "check": "biome check .",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/dev.ts",
    "template:reconcile": "tsx src/reconcile/cli.ts",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@rz-chain-reporter/contracts": "workspace:*",
    "@rz-chain-reporter/customer-template": "workspace:*",
    "@rz-chain-reporter/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@rz-chain-reporter/config": "workspace:*",
    "@types/pg": "8.21.0",
    "dotenv": "catalog:",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "catalog:"
  }
}
