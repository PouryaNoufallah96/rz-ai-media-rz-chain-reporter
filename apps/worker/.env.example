# Deployment identity, not a secret: selects which
# customer-templates/<key>/template.json this deployment runs.
CUSTOMER_TEMPLATE_KEY=crypto
DATABASE_URL=postgresql://chainreporter_app:replace-me@127.0.0.1:5432/rz-chain-reporter
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-me
# Optional. Set only when this deployment's customer template selects the local
# Ollama backend for a task (ADR 0008). Ollama binds to loopback on the VPS.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENROUTER_API_KEY=replace-me
WORKER_HEALTH_PORT=3002
NODE_ENV=development
