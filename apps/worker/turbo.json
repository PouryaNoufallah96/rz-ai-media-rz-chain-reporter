{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_EXTENDS$", ".env", ".env.*"]
    },
    "dev": {
      "with": ["worker#dev:inngest"],
      "env": [
        "CACHE_INVALIDATION_WEBHOOK_SECRET",
        "DATABASE_URL",
        "FIRECRAWL_API_KEY",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_DEV",
        "INNGEST_CONNECT_MAX_WORKER_CONCURRENCY",
        "NODE_ENV",
        "OLLAMA_BASE_URL",
        "OPENROUTER_API_KEY",
        "SENTRY_DSN",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY",
        "WEB_INTERNAL_BASE_URL",
        "WORKER_HEALTH_PORT",
        "WORKER_MODE",
        "APP_VERSION"
      ],
      "persistent": true,
      "cache": false
    }
  }
}
