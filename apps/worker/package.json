{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bindings:preflight": "tsx src/bindings/check-cli.ts preflight",
    "bindings:prestart": "tsx src/bindings/check-cli.ts prestart",
    "bindings:record": "tsx src/bindings/record-cli.ts",
    "build": "pnpm run build:template && pnpm run build:bundle",
    "build:bundle": "esbuild main=src/main.ts prestart=src/identity/prestart-cli.ts bindings-check=src/bindings/check-cli.ts bindings-record=src/bindings/record-cli.ts rearm=src/relay/rearm-cli.ts scheduled-probe=src/inngest/scheduled-probe-cli.ts generation-probe=src/inngest/generation-probe-cli.ts publishing-probe=src/inngest/publishing-probe-cli.ts fetch-probe=src/fetch/probe-cli.ts source-import=src/inngest/source-import-cli.ts editorial=src/editorial/fixture-cli.ts analysis-run=src/inngest/analysis-run-cli.ts --bundle --packages=bundle --external:sharp --platform=node --format=esm --target=node24 --banner:js=\"import { createRequire as __chainReporterCreateRequire } from 'node:module'; const require = __chainReporterCreateRequire(import.meta.url);\" --sourcemap --outdir=dist",
    "build:template": "tsx src/identity/build-cli.ts",
    "check": "biome check .",
    "check-types": "tsc --noEmit",
    "probe:copy-generation": "tsx src/inngest/copy-generation-probe-cli.ts",
    "probe:image-generation": "tsx src/inngest/image-generation-probe-cli.ts",
    "probe:publishing": "tsx src/inngest/publishing-probe-cli.ts",
    "probe:source-import": "tsx src/inngest/source-import-probe-cli.ts",
    "dev": "tsx watch --include ../../customer-templates src/main.ts",
    "dev:inngest": "inngest-cli dev --no-discovery",
    "fix": "biome check --write .",
    "generation-probe": "tsx src/inngest/generation-probe-cli.ts",
    "relay:rearm": "tsx src/relay/rearm-cli.ts",
    "scheduled-probe": "tsx src/inngest/scheduled-probe-cli.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@ai-sdk/otel": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@rz-chain-reporter/cache-invalidation": "workspace:*",
    "@rz-chain-reporter/contracts": "workspace:*",
    "@rz-chain-reporter/customer-template": "workspace:*",
    "@rz-chain-reporter/db": "workspace:*",
    "@rz-chain-reporter/env": "workspace:*",
    "@rz-chain-reporter/model-gateway": "workspace:*",
    "@rz-chain-reporter/storage": "workspace:*",
    "@sentry/node": "catalog:",
    "ai": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "catalog:",
    "firecrawl": "catalog:",
    "htmlparser2": "catalog:",
    "inngest": "catalog:",
    "sharp": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rz-chain-reporter/config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "inngest-cli": "1.44.0",
    "tsx": "4.23.12",
    "typescript": "catalog:"
  }
}
