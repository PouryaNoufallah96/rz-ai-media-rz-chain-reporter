# Deployment identity, not a secret: selects which
# customer-templates/<key>/template.json this deployment runs.
CUSTOMER_TEMPLATE_KEY=chainreporter
DATABASE_URL=postgresql://chainreporter_app:replace-me@127.0.0.1:5432/rz-chain-reporter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3001
# Emergency stop for new publishing effects. Omit when publishing is allowed.
# PUBLISHING_EMERGENCY_PAUSED=1
ASSISTANT_APPROVAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional; unset makes the internal cache-invalidation route fail closed.
# CACHE_INVALIDATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Local Dev Server: web mints realtime tokens against this API base URL.
# Never set INNGEST_EVENT_KEY on web.
INNGEST_DEV=1
INNGEST_SIGNING_KEY=replace-me
# Remote model gateway; required when any task routes remote (shipped fallback is remote).
OPENROUTER_API_KEY=
# Host Ollama; Compose uses host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=chainreporter
S3_SECRET_ACCESS_KEY=chainreporter-minio
S3_BUCKET=chainreporter-dev
