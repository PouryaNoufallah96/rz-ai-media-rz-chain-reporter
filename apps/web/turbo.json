{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/customer-templates/**",
        "!$TURBO_ROOT$/customer-templates/**/.DS_Store",
        ".env",
        ".env.*"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "ASSISTANT_APPROVAL_SECRET",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "APP_URL",
        "INNGEST_DEV",
        "INNGEST_SIGNING_KEY",
        "OLLAMA_BASE_URL",
        "OPENROUTER_API_KEY",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY",
        "APP_VERSION"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "build-metadata.json"
      ]
    },
    "check-types": {
      "outputs": ["tsconfig.tsbuildinfo"]
    }
  }
}
