{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "pnpm run build:template && pnpm run check-types && CHAINREPORTER_TYPES_CHECKED=1 next build",
    "build:template": "node --import tsx scripts/validate-template-build.ts",
    "check": "biome check .",
    "check-types": "next typegen && tsc --noEmit",
    "fix": "biome check --write .",
    "i18n:check": "node --import tsx scripts/check-messages.ts",
    "openapi:check": "node --conditions=react-server --import tsx scripts/generate-openapi.ts --check",
    "openapi:generate": "node --conditions=react-server --import tsx scripts/generate-openapi.ts",
    "operator:create": "node --conditions=react-server --import tsx scripts/create-operator.ts",
    "operator:reset-password": "node --conditions=react-server --import tsx scripts/reset-operator-password.ts",
    "probe:editorial-presentation": "node --import tsx scripts/editorial-presentation-probe.ts",
    "probe:editorial-freshness": "node --import tsx scripts/editorial-freshness-probe.ts",
    "probe:editorial-duplicate-tag": "node --import tsx scripts/editorial-duplicate-tag-probe.ts",
    "probe:telegram-zone-notice": "node --import tsx scripts/telegram-zone-notice-probe.ts",
    "probe:report-policy": "node --import tsx scripts/report-policy-probe.ts",
    "probe:revision-editor-state": "node --import tsx scripts/revision-editor-state-probe.ts",
    "probe:run-configuration": "node --import tsx scripts/run-configuration-probe.ts",
    "probe:assistant-approval": "node --import tsx scripts/assistant-approval-probe.ts",
    "probe:assistant-run-start": "node --conditions=react-server --import tsx scripts/assistant-run-start-probe.ts",
    "probe:assistant-read": "node --import tsx scripts/assistant-read-probe.ts",
    "probe:assistant-market": "node --experimental-test-module-mocks --conditions=react-server --import tsx scripts/assistant-market-probe.ts",
    "probe:assistant-container": "node --import tsx scripts/assistant-container-probe.ts",
    "start": "next start"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/react": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@orpc/zod": "catalog:",
    "@rz-chain-reporter/api": "workspace:*",
    "@rz-chain-reporter/auth": "workspace:*",
    "@rz-chain-reporter/cache-invalidation": "workspace:*",
    "@rz-chain-reporter/contracts": "workspace:*",
    "@rz-chain-reporter/customer-template": "workspace:*",
    "@rz-chain-reporter/db": "workspace:*",
    "@rz-chain-reporter/env": "workspace:*",
    "@rz-chain-reporter/i18n": "workspace:*",
    "@rz-chain-reporter/market-chart": "workspace:*",
    "@rz-chain-reporter/model-gateway": "workspace:*",
    "@rz-chain-reporter/storage": "workspace:*",
    "@rz-chain-reporter/ui": "workspace:*",
    "@sentry/nextjs": "catalog:",
    "@swc/helpers": "0.5.23",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "inngest": "catalog:",
    "lucide-react": "catalog:",
