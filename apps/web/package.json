    "@types/react-dom": "catalog:",
    "@types/three": "0.185.4",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "catalog:",
    "tsx": "4.23.13",
    "typescript": "catalog:"
  }
