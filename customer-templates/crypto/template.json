{
  "schemaVersion": 1,
  "customer": {
    "key": "crypto",
    "productName": "RZ ChainReporter"
  },
  "workspace": {
    "name": "RZ ChainReporter"
  },
  "models": {
    "tasks": {
      "generation-probe": {
        "backend": "remote",
        "model": "openai/gpt-4o-mini",
        "fallback": {
          "backend": "remote",
          "model": "openai/gpt-4.1-nano"
        }
      }
    }
  },
  "mediaBrands": [
    { "key": "rz-prime", "name": "RZ Prime" },
    { "key": "coin-hall", "name": "Coin Hall" },
    { "key": "chain-reporter", "name": "ChainReporter" },
    { "key": "meta-coin-guard", "name": "Meta Coin Guard" }
  ],
  "sources": [
    {
      "key": "coindesk-rss",
      "origin": "rss",
      "endpoint": "https://www.coindesk.com/arc/outboundfeeds/rss/",
      "name": "CoinDesk",
      "enabled": true
    },
    {
      "key": "cointelegraph-rss",
      "origin": "rss",
      "endpoint": "https://cointelegraph.com/rss",
      "name": "Cointelegraph",
      "enabled": true
    },
    {
      "key": "the-block-rss",
      "origin": "rss",
      "endpoint": "https://www.theblock.co/rss.xml",
      "name": "The Block",
      "enabled": true
    },
    {
      "key": "decrypt-rss",
      "origin": "rss",
      "endpoint": "https://decrypt.co/feed",
      "name": "Decrypt",
      "enabled": false
