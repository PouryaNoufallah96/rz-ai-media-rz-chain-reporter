  "brandDestinations": [
    { "brandKey": "rz-prime", "destinationKey": "chainreporter-telegram" },
    { "brandKey": "rz-prime", "destinationKey": "chainreporter-x" },
    { "brandKey": "coin-hall", "destinationKey": "chainreporter-telegram" },
    { "brandKey": "coin-hall", "destinationKey": "chainreporter-x" },
    { "brandKey": "chain-reporter", "destinationKey": "chainreporter-telegram" },
    { "brandKey": "chain-reporter", "destinationKey": "chainreporter-x" },
    { "brandKey": "meta-coin-guard", "destinationKey": "chainreporter-telegram" },
    { "brandKey": "meta-coin-guard", "destinationKey": "chainreporter-x" }
