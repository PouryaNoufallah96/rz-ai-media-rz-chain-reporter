        "label": "Request path",
        "focus": [
          "operator",
          "proxy",
          "web",
          "postgres"
        ],
        "note": "The operator reaches the web app through the proxy. A short mutation writes its intent and its work item in one transaction."
      },
      {
        "id": "durable-work",
        "label": "Durable work",
        "focus": [
          "postgres",
          "worker",
          "inngest",
          "gateway",
          "models"
        ],
        "note": "The worker claims work from the outbox and runs it as a retryable durable function. Every model call resolves through one gateway."
      },
      {
        "id": "outside-world",
        "label": "Outside world",
        "focus": [
          "worker",
          "sources",
          "platforms",
          "minio"
        ],
        "note": "Every outbound call leaves from the worker through one request guard. Object bytes reach the browser only through authenticated routes."
      }
    ]
  },
