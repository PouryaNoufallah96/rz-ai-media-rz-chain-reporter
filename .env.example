POSTGRES_PASSWORD=replace-with-a-random-local-development-password
# Deployment identity, not a secret: selects which
# customer-templates/<key>/template.json this deployment runs. Compose
# interpolates it into the web and worker build args and environment.
CUSTOMER_TEMPLATE_KEY=chainreporter
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/rz-chain-reporter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3001
ASSISTANT_APPROVAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional. WEB_INTERNAL_BASE_URL is set by docker-compose.yml.
# CACHE_INVALIDATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
SENTRY_DSN=
OPENROUTER_API_KEY=replace-me
# Optional. Set only when an enabled RSS source in this deployment's customer
# template selects a Firecrawl article-fetch mode; prestart then exits 2
# without it.
# FIRECRAWL_API_KEY=replace-me
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-me
INNGEST_DEV=1
WORKER_MODE=durable
APP_VERSION=dev
INNGEST_CONNECT_MAX_WORKER_CONCURRENCY=12
WORKER_HEALTH_PORT=3002
DEST_CHAINREPORTER_TELEGRAM_BOT_TOKEN=replace-me
X_API_KEY=replace-me
X_API_SECRET=replace-me
DEST_CHAINREPORTER_X_ACCESS_TOKEN=replace-me
DEST_CHAINREPORTER_X_ACCESS_TOKEN_SECRET=replace-me
# CUSTOMER_TEMPLATE_KEY=rzwire uses the equivalent DEST_RZWIRE_* bindings and
# keyless public CMC plus Binance for Market Analysis.
# DEST_RZWIRE_TELEGRAM_BOT_TOKEN=replace-me
# DEST_RZWIRE_X_ACCESS_TOKEN=replace-me
# DEST_RZWIRE_X_ACCESS_TOKEN_SECRET=replace-me
# MARKET_BINANCE_ENABLED=true
# MARKET_BINANCE_GEO_ALLOWED=true
# MARKET_BINANCE_ATTRIBUTION_IDENTITY=local-development
# MARKET_COINMARKETCAP_PUBLIC_ENABLED=true
# MARKET_COINMARKETCAP_PUBLIC_ATTRIBUTION_IDENTITY=local-development
OLLAMA_BASE_URL=http://127.0.0.1:11434
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=chainreporter
S3_SECRET_ACCESS_KEY=chainreporter-minio
S3_BUCKET=chainreporter-dev
