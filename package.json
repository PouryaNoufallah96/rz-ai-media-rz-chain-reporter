{
  "name": "rz-chain-reporter",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "node api.js && turbo run dev",
    "dev:stack": "docker compose up -d postgres minio --wait && docker compose run --rm minio-init && turbo run dev",
    "build": "node api.js && turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev --filter=web",
    "db:push": "turbo run db:push --filter=@rz-chain-reporter/db",
    "db:studio": "turbo run db:studio --filter=@rz-chain-reporter/db",
    "db:generate": "turbo run db:generate --filter=@rz-chain-reporter/db",
    "db:migrate": "turbo run db:migrate --filter=@rz-chain-reporter/db",
    "template:reconcile": "pnpm --filter @rz-chain-reporter/db template:reconcile",
    "bindings:preflight": "pnpm --filter worker bindings:preflight",
    "bindings:prestart": "pnpm --filter worker bindings:prestart",
    "bindings:record": "pnpm --filter worker bindings:record",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "turbo run check //#check:root",
    "check:root": "biome check .vscode/settings.json biome.json package.json tsconfig.json turbo.json",
    "fix": "pnpm run fix:root && turbo run fix",
    "fix:root": "biome check --write .vscode/settings.json biome.json package.json tsconfig.json turbo.json",
    "doctor": "CI=1 pnpm dlx -y react-doctor@latest . --yes",
    "i18n:check": "turbo run i18n:check --filter=web",
    "openapi:check": "turbo run openapi:check --filter=web",
    "validate": "turbo run check check-types i18n:check openapi:check //#check:root //#doctor --continue=always"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@rz-chain-reporter/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.21.0"
}
